# Envoi de la demande de devis par email à la société (optionnel).
# Si ces variables ne sont pas définies, l'API journalise la demande et
# renvoie le récapitulatif sans envoyer d'email (l'app reste fonctionnelle).

# Clé API Resend (https://resend.com)
RESEND_API_KEY=

# Adresse email de la société qui reçoit les demandes de devis
COMPANY_EMAIL=contact@logilift.fr

# Adresse expéditrice vérifiée sur Resend
FROM_EMAIL=devis@logilift.fr
